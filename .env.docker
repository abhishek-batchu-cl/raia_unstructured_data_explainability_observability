################################################################################
# RAIA Docker Environment Configuration
################################################################################
# Copy this file to .env and customize for your environment
# Never commit .env files with real credentials to version control!

# ============================================================================
# PostgreSQL Database
# ============================================================================
POSTGRES_DB=raia
POSTGRES_USER=raia_user
POSTGRES_PASSWORD=raia_secure_password_2025
POSTGRES_PORT=5432

# ============================================================================
# Redis Cache
# ============================================================================
REDIS_PASSWORD=raia_redis_password
REDIS_PORT=6379

# ============================================================================
# Backend Configuration
# ============================================================================
BACKEND_PORT=8000
SECRET_KEY=raia_super_secret_key_change_in_production_2025
ENVIRONMENT=production
LOG_LEVEL=info
WORKERS=4

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://frontend:5173

# ============================================================================
# Frontend Configuration
# ============================================================================
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# ============================================================================
# Prometheus Configuration
# ============================================================================
PROMETHEUS_PORT=9090

# ============================================================================
# Grafana Configuration
# ============================================================================
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_ROOT_URL=http://localhost:3000
GRAFANA_PLUGINS=

# ============================================================================
# Node Exporter (Optional)
# ============================================================================
NODE_EXPORTER_PORT=9100

# ============================================================================
# Email Notifications (Optional)
# ============================================================================
# Uncomment and configure if you want email notifications
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# FROM_EMAIL=noreply@raia.com

# ============================================================================
# Slack Notifications (Optional)
# ============================================================================
# Uncomment and configure if you want Slack notifications
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ============================================================================
# Webhook Notifications (Optional)
# ============================================================================
# Uncomment and configure if you want webhook notifications
# WEBHOOK_URL=https://your-webhook-endpoint.com/webhook

################################################################################
# Production Security Notes:
################################################################################
# 1. Change all default passwords before deploying to production
# 2. Use strong, randomly generated passwords
# 3. Never commit .env files to version control
# 4. Add .env to your .gitignore file
# 5. Use secrets management in production (AWS Secrets Manager, HashiCorp Vault, etc.)
# 6. Enable SSL/TLS for all external connections
# 7. Implement network segregation and firewall rules
# 8. Regularly rotate credentials
# 9. Monitor for suspicious activity
# 10. Keep all Docker images updated
################################################################################
